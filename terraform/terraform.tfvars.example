# Copy to terraform.tfvars if you want to change the defaults.
# Never put AWS access keys here - Terraform reads them from `aws configure`.
aws_region          = "ap-south-1"
environment         = "dev"
cluster_name        = "lostfound-eks"
vpc_cidr            = "10.30.0.0/16"
public_subnet_cidrs = ["10.30.1.0/24", "10.30.2.0/24"]
node_instance_type  = "t3.small"
node_desired_size   = 1
